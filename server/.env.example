# Copy to server/.env and fill in. server/.env is gitignored and must stay that way.

WATTS_ENV=development

# Local dev points at a Postgres on the developer's machine. On WSL with the
# server installed on the Windows side, host.docker.internal is the stable way
# to reach it — the NAT gateway address changes when the VM restarts. A Linux
# native install is postgresql+psycopg://watts:watts@localhost:5432/watts_dev.
WATTS_DATABASE_URL=postgresql+psycopg://watts:watts@host.docker.internal:5432/watts_dev

# Cookies are only marked Secure outside development, so http://localhost works.
WATTS_SESSION_TTL_DAYS=365

# Peppers the password reset codes: six digits hashed with a bare sha256 is a
# million element rainbow table, so a leaked database would be enough to take
# accounts over. Keyed with this, reversing a code needs the app host too.
# Generate with: openssl rand -base64 32
# Optional in development (a fixed dev pepper is used); the API refuses to start
# in production without it. Rotating it invalidates outstanding codes, which is
# harmless.
WATTS_SECRET_KEY=

# Outbound mail — password reset codes and the "your password changed" notice.
# Leave the host blank and messages are logged to the console instead of sent,
# code included, which is how the test suite and a machine without credentials
# run. Any SMTP server works; the account currently used is a dedicated Gmail
# one, whose password is a Google App Password (2-Step Verification must be on
# for the account) with the spaces Google displays it with removed.
#
# Do not quote WATTS_SMTP_FROM: docker compose env_file takes the value verbatim.
WATTS_SMTP_HOST=
WATTS_SMTP_PORT=587
WATTS_SMTP_USERNAME=
WATTS_SMTP_PASSWORD=
WATTS_SMTP_FROM=WATTS <auth.moates@gmail.com>

# Extra origins allowed to send credentialed requests. In production the PWA is
# same-origin with the API behind nginx, so this stays empty there.
WATTS_CORS_ORIGINS=http://localhost:1234

# DigitalOcean Spaces. Leave the key and secret blank and the FIT endpoints
# return 503 while the rest of the API works normally.
WATTS_SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
WATTS_SPACES_REGION=syd1

# The name of the Space itself, not a folder inside it. WATTS currently shares
# gym-junkie-01 and lives under the watts-01/ folder. Note that a Spaces access
# key is scoped to a whole Space and cannot be limited to a folder, so this
# key also reaches everything else in the bucket, db-backups/ included. A
# dedicated Space is the only way to bound that.
WATTS_SPACES_BUCKET=gym-junkie-01
WATTS_SPACES_KEY=
WATTS_SPACES_SECRET=

# Every object is stored at <prefix>/fit/<user_id>/<activity_id>.fit.
#
# Dev and prod MUST NOT share a prefix. The orphan sweep deletes anything under
# <prefix>/fit/ with no matching row in ITS OWN database, so a sweep run locally
# against the production prefix would delete real riders' FIT files. Production
# uses watts-01/prod; leave this as watts-01/dev.
WATTS_SPACES_PREFIX=watts-01/dev
